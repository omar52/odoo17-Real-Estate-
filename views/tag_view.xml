<odoo>
    <!--  so view is needed for user to execute crud operations -->
    <!--  Tree View -->
    <record id="tag_view_tree" model="ir.ui.view">
        <field name="name">tag tree</field>
        <field name="model">tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>

            </tree>
        </field>
    </record>

    <!--  Form View -->
    <record id="tag_view_form" model="ir.ui.view">
        <field name="name">tag form</field>
        <field name="model">tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Tagged Props">
                            <field name="property_ids" widget="many2many_tags"/>
                        </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!--  action is used to execute the crud operations  -->
    <!--  action used is of type (window action), so when I click on this action it will open a view  -->
    <record id="tag_action" model="ir.actions.act_window">
        <field name="name">tag</field>
        <field name="res_model">tag</field>
    </record>

    <menuitem
            id="tag_menu_item"
            name="tags"
            parent="configuration_menu"
            action="tag_action"
    />
</odoo>