<odoo>
    <!--  so view is needed for user to execute crud operations -->
    <!--  Tree View -->
    <record id="property_history_view_tree" model="ir.ui.view">
        <field name="name">property history tree</field>
        <field name="model">property.history</field>
        <field name="arch" type="xml">

            <!--            <tree create="0" edit="0" delete="0">-->
            <tree>
                <field name="user_id"/>
                <field name="property_id"/>
                <field name="old_state"/>
                <field name="new_state"/>
            </tree>

        </field>
    </record>

    <!--  Form View -->
    <record id="property_history_view_form" model="ir.ui.view">
        <field name="name">property history form</field>
        <field name="model">property.history</field>
        <field name="arch" type="xml">
            <!--            <form create="0" edit="0" delete="0">-->
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="property_id"/>
                        </group>

                        <group>
                            <field name="old_state"/>
                            <field name="new_state"/>
                            <field name="reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bedrooms">
                            <!--                            as this field is One2many i can handle the tree view-->
                            <field name="line_ids" readonly="1">
                                <tree>
                                    <field name="description"/>
                                    <field name="area"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!--  action is used to execute the crud operations  -->
    <!--  action used is of type (window action), so when I click on this action it will open a view  -->
    <!--    windows action -->
    <record id="property_history_action" model="ir.actions.act_window">
        <field name="name">Property History</field>
        <field name="res_model">property.history</field>
    </record>


    <menuitem
            id="prpoperty_history_menu_item"
            name="History"
            parent="properties_menu"
            action="property_history_action"
    />
</odoo>